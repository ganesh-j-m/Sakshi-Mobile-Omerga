# Used by docker-compose.yml — copy to .env.docker and fill in. Never commit the real file.
POSTGRES_USER=sakshi
POSTGRES_PASSWORD=change-this-strong-db-password
JWT_SECRET=generate-with-openssl-rand-hex-48
PUBLIC_SITE_URL=https://www.your-domain.in
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
SEED_SUPER_ADMIN_LOGIN=superadmin
SEED_SUPER_ADMIN_PASSWORD=ChangeMe@12345
SEED_DEMO_DATA=true
# Optional: automatic bill sending on WhatsApp (see docs/WHATSAPP_API.md)
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_TEMPLATE_NAME=bill_invoice
WHATSAPP_TEMPLATE_LANG=en
