# ─────────────────────────────────────────────────────────────
# Sakshi Mobile API — environment variables
# Copy to `.env` and fill in real values. NEVER commit `.env`.
# ─────────────────────────────────────────────────────────────

NODE_ENV=development
PORT=4000

# PostgreSQL connection string
DATABASE_URL=postgres://postgres:postgres@localhost:5432/sakshi_mobile
# Set to "true" for managed Postgres that requires SSL (Neon, Supabase, Render, RDS…)
DATABASE_SSL=false

# Long random string (min 32 chars). Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string-of-at-least-32-characters
SESSION_TTL_HOURS=12

# Public URL of the website (used for CORS, cookies, sitemap, OG tags)
CLIENT_URL=http://localhost:5173
PUBLIC_SITE_URL=http://localhost:5173
# Comma separated list of extra allowed CORS origins (optional)
CORS_ORIGINS=

# Serve the built React app from Express (single-server deployment)
SERVE_CLIENT=false
CLIENT_DIST_DIR=../client/dist

# ── Image storage ────────────────────────────────────────────
# If Cloudinary values are set, uploads go to Cloudinary.
# Otherwise images are stored on local disk in UPLOAD_DIR (dev only).
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=sakshi-mobile
UPLOAD_DIR=./uploads
MAX_UPLOAD_MB=5

# ── WhatsApp Business Cloud API (optional) ───────────────
# When set, every new bill is sent to the customer's WhatsApp AUTOMATICALLY.
# Leave empty to use click-to-chat (staff presses Send in WhatsApp).
# Setup guide: docs/WHATSAPP_API.md
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_TEMPLATE_NAME=bill_invoice
WHATSAPP_TEMPLATE_LANG=en
WHATSAPP_API_VERSION=v23.0

# ── Backups ──────────────────────────────────────────────────
BACKUP_DIR=./backups
# Path to pg_dump binary (must match server major version)
PG_DUMP_PATH=pg_dump
BACKUP_RETENTION=14

# ── First Super Admin (used only by `npm run db:seed`) ───────
SEED_SUPER_ADMIN_LOGIN=superadmin
SEED_SUPER_ADMIN_PASSWORD=ChangeMe@12345
SEED_SUPER_ADMIN_NAME=Super Admin
# Set to "false" to seed only the admin + settings, without demo catalogue
SEED_DEMO_DATA=true
